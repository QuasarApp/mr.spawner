#ifndef CORE_GLOBAL_H
#define CORE_GLOBAL_H

#define CORE_VERSION "@MRSPAWNER_VERSION@"

// The Core module is builded as a static library. The export macro is empty
// for the consumers, only the library build itself uses the export
// attributes (so the module can be switched to a shared library later).
#if defined(CORE_LIBRARY)
#  if defined(_WIN32) || defined(__CYGWIN__)
#    define CORE_EXPORT __declspec(dllexport)
#  elif defined(__GNUC__)
#    define CORE_EXPORT __attribute__((visibility("default")))
#  endif
#else
#  define CORE_EXPORT
#endif

#endif // CORE_GLOBAL_H
